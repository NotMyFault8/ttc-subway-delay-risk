[Unit]
Description=TTC daily batch prediction
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/ttc-subway-delay-risk
EnvironmentFile=/opt/ttc-subway-delay-risk/.env
ExecStart=/bin/sh -c '.venv/bin/ttc-pipeline predict --dataset data/production-windows.json --date "$(TZ=America/Toronto date +%%F)" --publish'
User=ttc
NoNewPrivileges=true
PrivateTmp=true
